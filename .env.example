# Flask Core Settings
# Secret key used for signing session cookies and CSRF tokens
SECRET_KEY=dev-secret-key-change-in-production

# Salt used for extra security operations (e.g., password reset tokens)
SECURITY_PASSWORD_SALT=dev-password-salt

# Database Configuration
# Default is SQLite for local development; use postgresql://... for production
DATABASE_URL=sqlite:///shop.db

# Flask Environment Configuration
# Options: development, production, testing
FLASK_CONFIG=development
FLASK_APP=run.py
FLASK_DEBUG=1

# Stripe Payment Gateway API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Flask-Mail SMTP Configuration
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_DEFAULT_SENDER=noreply@ecommerce.com
